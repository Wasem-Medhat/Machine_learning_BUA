# Task:Explore how changing decision thresholds affects classification results.
from sklearn.datasets import load_breast_cancer
from sklearn.model_selection import train_test_split
from sklearn.linear_model import LogisticRegression
from sklearn.metrics import accuracy_score

data = load_breast_cancer()
X = data.data
y = data.target

X_train, X_test, y_train, y_test = train_test_split(
    X, y, test_size=0.3, random_state=42
)

model = LogisticRegression(random_state=42)
model.fit(X_train, y_train)

y_prob = model.predict_proba(X_test)[:, 1]

thresholds = [0.3, 0.5, 0.7]

for th in thresholds:
    y_pred = (y_prob >= th).astype(int)
    acc = accuracy_score(y_test, y_pred)
    print(f"Threshold = {th} → Accuracy = {acc:.4f}")
#-----------------------------------------------------------------------------------------------
#Interpretation of the Output:
The threshold is the cutoff value we choose:

* If probability ≥ threshold → predict Positive (1)

* If probability < threshold → predict Negative (0)

Default threshold = 0.5


Threshold = 0.3 → Accuracy = 0.9591

* Very low threshold (0.3)

* Model becomes more aggressive in predicting 1

* Predicts more positives

* Leads to more false positives → accuracy goes down

Threshold = 0.5 → Accuracy = 0.9708

Gives a balance between:

* Precision

* Recall

* Accuracy

Threshold = 0.7 → Accuracy = 0.9708

* Higher threshold means the model becomes more strict

* It predicts fewer positives

* Surprisingly, accuracy stays the same as 0.5

 Increasing threshold did not change accuracy.

 This means most probabilities are already very clear (close to 0 or close to 1).


#I learned From This Output:


 Changing the threshold affects model predictions

* Lower threshold → more positive predictions
* Higher threshold → more negative predictions
